# העתק קובץ זה ל-.env לבדיקה מקומית (npm run scan / npm run update-universe).
# באותם שמות בדיוק יש להגדיר את אלה כ-Secrets ב-GitHub Actions ו-Environment Variables ב-Vercel.

DATABASE_URL=postgres://user:password@host:5432/dbname
SEC_USER_AGENT="Ron <your-email@example.com>"

# רק ל-Vercel (לכפתור "סרוק הכל עכשיו"):
GITHUB_TOKEN=ghp_xxx
GITHUB_REPO=your-github-username/momentum-scanner
